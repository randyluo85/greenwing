<view class="login-page">
  <view class="login-content">
    <image src="/images/logo.png" mode="aspectFit" class="logo" />
    <view class="deco-line"></view>
    <text class="subtitle">重庆出版社官方阅读社群</text>
  </view>

  <view class="login-actions">
    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="checkbox-wrap">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="checkbox-tick">✓</text>
        </view>
      </view>
      <text class="agreement-text">我已阅读并同意《<text class="link" bindtap="goUserAgreement">用户协议</text>》和《<text class="link" bindtap="goPrivacyPolicy">隐私政策</text>》</text>
    </view>
    <button class="wx-login-btn {{agreed ? 'btn-active' : 'btn-disabled'}}" bindtap="onWxLogin" loading="{{loading}}" disabled="{{!agreed}}">
      <view class="wx-icon-wrap">
        <text class="wx-icon-text">W</text>
      </view>
      <text>微信授权登录</text>
    </button>
  </view>
</view>
